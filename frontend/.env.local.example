# NXQ Social Frontend — Environment Variables
# Copy to .env.local and fill in values.
# NEXT_PUBLIC_* values are embedded during `next build`; rebuild after changes.

# ── API ───────────────────────────────────────────────────────────────────────
# URL of the backend API (no trailing slash)
NEXT_PUBLIC_API_URL="https://api.nxqsocial.com/api"

# ── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://nxqsocial.com"

# ── Signup protection ─────────────────────────────────────────────────────────
# Public Cloudflare Turnstile site key. The matching secret belongs only in the
# backend environment and must never use a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="replace-with-cloudflare-turnstile-site-key"

# ── Feature rollout ───────────────────────────────────────────────────────────
NEXT_PUBLIC_CALLS_ENABLED=false
NEXT_PUBLIC_LIVE_ENABLED=false
