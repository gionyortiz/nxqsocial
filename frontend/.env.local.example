# NXQ Social Frontend — Environment Variables
# Copy to .env.local and fill in values.
# NEXT_PUBLIC_* values are embedded during `next build`; rebuild after changes.

# ── API ───────────────────────────────────────────────────────────────────────
# Docker release builds require an explicit target and accept only its pinned
# origin pair. Railway staging uses `staging`; the Windows rollback uses
# `production`.
NXQ_RELEASE_TARGET="staging"

# Approved Railway staging API URL (no trailing slash)
NEXT_PUBLIC_API_URL="https://api-staging.nxqsocial.com/api"

# ── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://staging.nxqsocial.com"

# ── Signup protection ─────────────────────────────────────────────────────────
# Public Cloudflare Turnstile site key. The matching secret belongs only in the
# backend environment and must never use a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="replace-with-cloudflare-turnstile-site-key"

# ── Feature rollout ───────────────────────────────────────────────────────────
NEXT_PUBLIC_CALLS_ENABLED=false
NEXT_PUBLIC_LIVE_ENABLED=false
# Paid gifts have no public activation switch. The authenticated backend
# catalog remains the source of truth and defaults to disabled.
