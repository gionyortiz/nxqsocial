# ─────────────────────────────────────────────────────────────────────────────
# NXQ Social Backend — Environment Variables
# Copy this file to .env and fill in all values before running in production.
# Never commit .env to source control.
# NODE_ENV=production enables fail-fast validation. The API will not start with
# missing core services, placeholder secrets, unsafe origins, or incomplete
# provider credential groups.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:STRONG_PASSWORD@localhost:5432/nxqsocial"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_WITH_64_BYTE_HEX_SECRET"
JWT_EXPIRES_IN="7d"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://:REDIS_PASSWORD@localhost:6379"

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV="production"
# Comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_URL="https://nxqsocial.com,https://www.nxqsocial.com"
APP_BASE_URL="https://nxqsocial.com"
# Canonical public API base used in generated media URLs.
API_BASE_URL="https://api.nxqsocial.com/api"
# Optional exact immediate-peer IPs allowed to supply proxy client-IP headers.
# TRUSTED_PROXY_CIDRS is available for a controlled proxy subnet. Railway's
# documented 100.0.0.0/8 edge subnet is trusted automatically only when both
# RAILWAY_ENVIRONMENT_ID and RAILWAY_SERVICE_ID are injected by Railway.
# Leave both empty on Railway. For self-hosting, keep the application origin
# bound to loopback and add only the verified immediate reverse-proxy address.
TRUSTED_PROXY_IPS=""
TRUSTED_PROXY_CIDRS=""
# Required only when a Cloudflare-proxied hostname points to Railway. Populate
# from Cloudflare's published IPv4/IPv6 lists; do not use a catch-all CIDR.
CLOUDFLARE_PROXY_CIDRS=""

# ── Registration ──────────────────────────────────────────────────────────────
# Registration is open; invitation codes are not required or evaluated. The
# backend temporarily ignores the obsolete field from cached legacy clients.

# New accounts must pass Turnstile and verify email before receiving a normal
# session. Production defaults secure when this variable is omitted.
SIGNUP_HARDENING_ENABLED=true
TURNSTILE_SECRET_KEY="REPLACE_WITH_TURNSTILE_SECRET_KEY"
TURNSTILE_ALLOWED_HOSTNAMES="nxqsocial.com,www.nxqsocial.com"
# Independent random 32+ byte secret used to HMAC email OTPs at rest.
OTP_PEPPER="REPLACE_WITH_64_CHARACTER_RANDOM_HEX"

# ── AI Assistant rollout ─────────────────────────────────────────────────────
# Enable Build 30 AI endpoints.
AI_ASSISTANT_ENABLED=false
# Rollout bucket percent for enabled accounts (0-100).
AI_ASSISTANT_ROLLOUT_PERCENT=10

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# One-time fee (in cents) charged via Stripe Checkout before a user can start
# the ID_VERIFIED Stripe Identity check. Defaults to 499 ($4.99) in code.
ID_VERIFICATION_PRICE_CENTS="499"

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="NXQ Social <noreply@mail.nxqsocial.com>"

# ── SMS (Twilio) ──────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_FROM_NUMBER="+1XXXXXXXXXX"

# ── Calls and live video (LiveKit) ───────────────────────────────────────────
# Leave all three unset to disable LiveKit, or configure the complete group.
# LIVEKIT_URL="wss://your-project.livekit.cloud"
# LIVEKIT_API_KEY="..."
# LIVEKIT_API_SECRET="..."

# ── Persistent storage (choose ONE option) ───────────────────────────────────
# Production requires separate public and quarantine buckets. Never attach a
# public domain or r2.dev URL to the quarantine bucket. Browser PUT CORS belongs
# on quarantine only and must name the exact frontend origin and Content-Type
# header. Use separate lifecycle rules: expire client-writable incoming/
# objects after 1 day, and retain server-owned processing/media-finalizing/
# snapshots for at least 7 days so recovery/retry jobs are not raced by storage.

# Option A: Cloudflare R2
# S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_BUCKET="nxqsocial-production-public"
# S3_QUARANTINE_BUCKET="nxqsocial-production-quarantine"
# Required whenever S3_ENDPOINT is set; use the public/custom media domain,
# never the private R2 API endpoint.
# S3_PUBLIC_BASE_URL="https://media.nxqsocial.com"
# Use an R2 token scoped only to the two buckets above. Browser clients may PUT
# only through short-lived quarantine presigns; never expose this token.
# AWS_ACCESS_KEY_ID="REPLACE_WITH_R2_ACCESS_KEY"
# AWS_SECRET_ACCESS_KEY="REPLACE_WITH_R2_SECRET_KEY"
# AWS_REGION="auto"

# Option B: AWS S3
# S3_BUCKET_NAME="nxqsocial-production-public"
# S3_QUARANTINE_BUCKET="nxqsocial-production-quarantine"
# S3_PUBLIC_BASE_URL="https://nxqsocial-production-public.s3.amazonaws.com"
# AWS_ACCESS_KEY_ID="REPLACE_WITH_STORAGE_ACCESS_KEY"
# AWS_SECRET_ACCESS_KEY="REPLACE_WITH_STORAGE_SECRET_KEY"
# AWS_REGION="us-east-1"

# ── AWS Rekognition + private moderation S3 ──────────────────────────────────
# Required in production and intentionally separate from the R2/storage AWS_*
# credentials above. The S3 bucket must be private, in REKOGNITION_REGION, and
# must not have a public domain. Scope IAM to the nxq-social/ prefix plus the
# required Detect/Start/Get moderation APIs. Expire moderation objects after a
# short interval as a crash-recovery backstop.
REKOGNITION_REGION="us-east-1"
REKOGNITION_ACCESS_KEY_ID="REPLACE_WITH_MODERATION_ACCESS_KEY"
REKOGNITION_SECRET_ACCESS_KEY="REPLACE_WITH_MODERATION_SECRET_KEY"
REKOGNITION_S3_BUCKET="nxqsocial-production-moderation-private"

# ── One-off local-media migration gates (do not persist on the API) ──────────
# Set all seven only in the controlled migration process. The database value is
# a 64-character SHA-256 digest of DATABASE_URL; never paste or log the URL
# while producing it. The bucket, endpoint/account identity, public base URL,
# and canonical absolute upload root must exactly match the approved staging
# destination and retained source.
# MIGRATE_LOCAL_MEDIA_CONFIRM="UPLOAD_AND_UPDATE"
# MIGRATE_EXPECTED_DATABASE_URL_SHA256="<64-lowercase-hex-sha256-only>"
# MIGRATE_EXPECTED_BUCKET="<exact-staging-public-bucket>"
# MIGRATE_EXPECTED_UPLOAD_ROOT="<canonical-absolute-retained-upload-root>"
# MIGRATE_EXPECTED_S3_ENDPOINT="https://<r2-account-id>.r2.cloudflarestorage.com"
# MIGRATE_EXPECTED_S3_ACCOUNT_ID="<exact-r2-account-id>"
# MIGRATE_EXPECTED_S3_PUBLIC_BASE_URL="https://<exact-staging-media-host>"

# ── Admin seed credentials (used by: npx prisma db seed) ─────────────────────
ADMIN_EMAIL="admin@nxqsocial.com"
ADMIN_USERNAME="nxqadmin"
ADMIN_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"
