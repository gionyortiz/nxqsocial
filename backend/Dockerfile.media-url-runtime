# Preserve the exact healthy production runtime, including the deployed
# password-reset safeguard. Patch only the two legacy response serializers in
# place so no newer upload, deletion, lifecycle, or auth modules are introduced.
FROM nexaquantumchat-backend:password-reset-bdd77da

COPY scripts/patch-legacy-media-url-runtime.cjs /tmp/patch-legacy-media-url-runtime.cjs
RUN node /tmp/patch-legacy-media-url-runtime.cjs \
    && rm /tmp/patch-legacy-media-url-runtime.cjs

LABEL nxq.git.commit="5163dbb21130ce0141ce959560f5078952418b1a"
LABEL nxq.media.guard.commit="5163dbb21130ce0141ce959560f5078952418b1a"
LABEL nxq.password.reset.commit="bdd77da7b04e0584e5aba96f232c7abf06e79f92"
LABEL nxq.runtime.baseline="sha256:82539aa1b59e6dbb6cedd42ac8486c33637093eee0509cb0d8d75b4c7aff21a9"

CMD ["node", "dist/src/main.js"]
