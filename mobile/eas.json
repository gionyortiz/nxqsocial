{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.nxqsocial.com/api",
        "EXPO_PUBLIC_TURNSTILE_MOBILE_URL": "https://nxqsocial.com/turnstile/mobile-signup",
        "EXPO_PUBLIC_USE_RN_FETCH": "false",
        "EXPO_PUBLIC_SHOW_LOGIN_DEBUG": "false"
      }
    },
    "staging-native": {
      "distribution": "internal",
      "environment": "preview",
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NXQ_MOBILE_VARIANT": "staging",
        "NXQ_STAGING_CONFIG_READY": "false",
        "NXQ_STAGING_EAS_PROJECT_ID": "__REQUIRED__",
        "EXPO_PUBLIC_APP_VARIANT": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "__REQUIRED__",
        "EXPO_PUBLIC_TURNSTILE_MOBILE_URL": "__REQUIRED__",
        "EXPO_PUBLIC_WEB_BASE_URL": "__REQUIRED__",
        "EXPO_PUBLIC_USE_RN_FETCH": "false",
        "EXPO_PUBLIC_LIVE_NATIVE_ENABLED": "false",
        "EXPO_PUBLIC_PUSH_ENABLED": "false",
        "EXPO_PUBLIC_SHOW_LOGIN_DEBUG": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.nxqsocial.com/api",
        "EXPO_PUBLIC_TURNSTILE_MOBILE_URL": "https://nxqsocial.com/turnstile/mobile-signup",
        "EXPO_PUBLIC_USE_RN_FETCH": "false",
        "EXPO_PUBLIC_SHOW_LOGIN_DEBUG": "false"
      }
    },
    "compiletest": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.nxqsocial.com/api",
        "EXPO_PUBLIC_TURNSTILE_MOBILE_URL": "https://nxqsocial.com/turnstile/mobile-signup",
        "EXPO_PUBLIC_USE_RN_FETCH": "false",
        "EXPO_PUBLIC_LIVE_NATIVE_ENABLED": "false",
        "EXPO_PUBLIC_SHOW_LOGIN_DEBUG": "false"
      }
    },
    "livetest": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.nxqsocial.com/api",
        "EXPO_PUBLIC_TURNSTILE_MOBILE_URL": "https://nxqsocial.com/turnstile/mobile-signup",
        "EXPO_PUBLIC_USE_RN_FETCH": "false",
        "EXPO_PUBLIC_LIVE_NATIVE_ENABLED": "true",
        "EXPO_PUBLIC_SHOW_LOGIN_DEBUG": "false"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.nxqsocial.com/api",
        "EXPO_PUBLIC_TURNSTILE_MOBILE_URL": "https://nxqsocial.com/turnstile/mobile-signup",
        "EXPO_PUBLIC_USE_RN_FETCH": "false",
        "EXPO_PUBLIC_LIVE_NATIVE_ENABLED": "false",
        "EXPO_PUBLIC_SHOW_LOGIN_DEBUG": "false"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6775623679",
        "appleTeamId": "5J49RDX477"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}
